{
  "name": "linuxtrainer",
  "version": "1.7.0",
  "description": "DevOps/Linux термінал-тренажер у стилі Terminal Drill",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "icon": "node assets/build-icon.js",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "keywords": [
    "linux",
    "devops",
    "training",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.andriiliaskun.linuxtrainer",
    "productName": "LinuxTrainer",
    "icon": "assets/icon.ico",
    "directories": { "output": "dist" },
    "files": ["main.js", "renderer/**/*", "package.json"],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "AndriiLiaskun",
      "repo": "linuxtrainer"
    }
  }
}
